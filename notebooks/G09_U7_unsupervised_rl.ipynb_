nique_values\": 2,\n        \"samples\": [\n          1,\n          0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Percentage (%)\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 34.436100243784864,\n        \"min\": 25.65,\n        \"max\": 74.35,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          74.35,\n          25.65\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","Silhouette Score: 0.1126\n"]}]},{"cell_type":"code","source":["# Analyze employee characteristics within each cluster\n","\n","profile_features = [\n","    \"Age\",\n","    \"MonthlyIncome\",\n","    \"DistanceFromHome\",\n","    \"YearsAtCompany\",\n","    \"YearsInCurrentRole\",\n","    \"YearsWithCurrManager\",\n","    \"JobLevel\",\n","    \"JobSatisfaction\",\n","    \"EnvironmentSatisfaction\",\n","    \"WorkLifeBalance\",\n","    \"JobInvolvement\",\n","    \"TrainingTimesLastYear\"\n","]\n","\n","available_features = [col for col in profile_features if col in df_clustered.columns]\n","\n","# Calculate average characteristics per cluster\n","cluster_profile = df_clustered.groupby(\"Cluster\")[available_features].mean()\n","\n","print(\"Employee Characteristics by Cluster\")\n","print(\"=\" * 60)\n","\n","display(cluster_profile.round(2))\n","\n","# Compare attrition rates across clusters (not used to create clusters)\n","if \"Attrition\" in df_clustered.columns:\n","    attrition_comparison = pd.crosstab(\n","        df_clustered[\"Cluster\"],\n","        df_clustered[\"Attrition\"],\n","        normalize=\"index\"\n","    ) * 100\n","\n","    print(\"\\nAttrition Distribution Within Each Cluster (%)\")\n","    display(attrition_comparison.round(2))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":359},"id":"khnNtiFuYTfI","execut