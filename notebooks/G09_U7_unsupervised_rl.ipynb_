        34.25,\n          46.64\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"MonthlyIncome\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 6427.6713516638365,\n        \"min\": 4542.69,\n        \"max\": 13632.79,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          4542.69,\n          13632.79\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"YearsAtCompany\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 5.833630944789017,\n        \"min\": 5.23,\n        \"max\": 13.48,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          5.23,\n          13.48\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"DistanceFromHome\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.3818376618407363,\n        \"min\": 8.77,\n        \"max\": 9.31,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          9.31,\n          8.77\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"JobSatisfaction\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.028284271247461613,\n        \"min\": 2.72,\n        \"max\": 2.76,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          2.72,\n          2.76\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}}]},{"cell_type":"markdown","source":["PCA – Dimensionality Reduction"],"metadata":{"id":"CSUKESqSa23F"}},{"cell_type":"code","source":["# Apply PCA to reduce the five scaled features to two components\n","\n","pca = PCA(n_components=2, random_state=42)\n","X_pca = pca.fit_transform(X_scaled)\n","\n","pca_df = pd.DataFrame({\n","    \"PC1\": X_pca[:, 0],\n","    \"PC2\": X_pca[:, 1],\n","    \"Cluster\": cluster_labels\n","})\n","\n","# Display the explained variance\n","print(\"Explained variance ratio:\")\n","print(\"PC1:\", round(pca.explained_variance_ratio_[0] * 100, 2), \"%\")\n","print(\"PC2:\", round(pca.explained_variance_ratio_[1] * 100, 2), \"%\")\n","print(\"Total variance explained:\",\n","      round(sum(pca.explained_variance_ratio_) * 100, 2), \"%\")\n","\n","# Plot employees in two-dimensional PCA space\n","plt.figure(figsize=(9, 6))\n","\n","for cluster in sorted(pca_df[\"Cluster\"].unique()):\n","    subset = pca_df[pca_df[\"Cluster\"] == cluster]\n","    plt.scatter(\n","        subset[\"PC1\"],\n","        subset[\"PC2\"],\n","        label=f\"Cluster {cluster}\",\n","        alpha=0.6\n","    )\n","\n","plt.title(\"PCA Visualization of Employee Clusters\")\n","plt.xlabel(\"Principal Component 1\")\n","plt.ylabel(\"Principal Component 2\")\n","plt.legend()\n","plt.grid(alpha=0.25)\n","plt.tight_layout()\n","\n","# Save the PCA visualization\n","plt.savefig(\n","    os.path.join(OUTPUT_DIR, \"pca_clusters.png\"),\n","    dpi=300,\n","    bbox_inches=\"tight\"\n",")\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":676},"id":"VKrdlPSPaxZ3","executionInfo":{"status":"ok","timestamp":1795605345223,"user_tz":-180,"elapsed":3079,"user":{"displayName":"Clare Nabwile","userId":"09967253055330741327"}},"outputId":"648ef5c5-012b-4289-a0c9-807a4ae6ec6c"},"execution_count":24,"outputs":[{"output_type":"stream","name":"stdout","text":["Explained variance ratio:\n","PC1: 37.77 %\n","PC2: 20.08 %\n","Total variance explained: 57.84 %\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 900x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Generate the 5-nearest-neighbor distance plot to help select DBSCAN eps\n","\n","from sklearn.neighbors import NearestNeighbors\n","\n","neighbors = NearestNeighbors(n_neighbors=5)\n","neighbors_fit = neighbors.fit(X_scaled)\n","\n","distances, indices = neighbors_fit.kneighbors(X_scaled)\n","\n","# Sort the distances to the fifth nearest neighbor\n","k_distances = np.sort(distances[:, 4])\n","\n","plt.figure(figsize=(9, 5))\n","plt.plot(k_distances)\n","plt.title(\"5-Nearest Neighbor Distance Plot for DBSCAN\")\n","plt.xlabel(\"Points sorted by distance\")\n","plt.ylabel(\"Distance to 5th nearest neighbor\")\n","plt.grid(alpha=0.3)\n","plt.tight_layout()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":507},"id":"c1744NcNbFIR","executionInfo":{"status":"ok","timestamp":1795605422502,"user_tz":-180,"elapsed":842,"user":{"displayName":"Clare Nabwile","userId":"09967253055330741327"}},"outputId":"630780d9-59af-4da2-8552-afc22d5eec4d"},"execution_count":25,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 900x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Generate the 5-nearest-neighbor distance plot to guide DBSCAN eps selection\n","\n","from sklearn.neighbors import NearestNeighbors\n","\n","neighbors = NearestNeighbors(n_neighbors=5)\n","neighbors.fit(X_scaled)\n","\n","distances, indices = neighbors.kneighbors(X_scaled)\n","\n","# Sort the distance to the 5th nearest neighbor\n","k_distances = np.sort(distances[:, 4])\n","\n","plt.figure(figsize=(9, 5))\n","plt.plot(k_distances)\n","plt.title(\"5-Nearest Neighbor Distance Plot for DBSCAN\")\n","plt.xlabel(\"Points sorted by distance\")\n","plt.ylabel(\"Distance to 5th nearest neighbor\")\n","plt.grid(alpha=0.3)\n","plt.tight_layout()\n","\n","# Save the plot\n","plt.savefig(\n","    os.path.join(OUTPUT_DIR, \"k_distance.png\"),\n","    dpi=300,\n","    bbox_inches=\"tight\"\n",")\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":507},"id":"hOkdyrRebOT7","executionInfo":{"status":"ok","timestamp":1795605461309,"user_tz":-180,"elapsed":2049,"user":{"displayName":"Clare Nabwile","userId":"09967253055330741327"}},"outputId":"d45a5113-ba58-4b24-b4f3-a56ecc1d2f1b"},"execution_count":26,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 900x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Apply DBSCAN to the same scaled features used for K-Means\n","\n","from sklearn.cluster import DBSCAN\n","\n","dbscan = DBSCAN(eps=1.0, min_samples=5)\n","\n","dbscan_labels = dbscan.fit_predict(X_scaled)\n","\n","# Count clusters and noise points\n","unique_labels = set(dbscan_labels)\n","\n","dbscan_clusters = len(unique_labels - {-1})\n","noise_points = np.sum(dbscan_labels == -1)\n","\n","print(\"DBSCAN results\")\n","print(\"Number of clusters (excluding noise):\", dbscan_clusters)\n","print(\"Number of noise points:\", noise_points)\n","print(\"Percentage of noise points:\",\n","      round(noise_points / len(dbscan_labels) * 100, 2), \"%\")\n","\n","print(\"\\nCluster sizes:\")\n","print(pd.Series(dbscan_labels).value_counts().sort_index())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"cNN-vxn7bYYp","executionInfo":{"status":"ok","timestamp":1795605752444,"user_tz":-180,"elapsed":44,"user":{"displayName":"Clare Nabwile","userId":"09967253055330741327"}},"outputId":"5de87385-0e92-44ab-d6dd-7a16a80f52bd"},"execution_count":31,"outputs":[{"output_type":"stream","name":"stdout","text":["DBSCAN results\n","Number of clusters (excluding noise): 2\n","Number of noise points: 113\n","Percentage of noise points: 7.69 %\n","\n","Cluster sizes:\n","-1     113\n"," 0    1354\n"," 1       3\n","Name: count, dtype: int64\n"]}]},{"cell_type":"code","source":["# Examine attrition values before calculating cluster attrition rates\n","\n","print(\"Attrition values in the dataset:\")\n","print(df[\"Attrition\"].value_counts())\n","print(\"\\nUnique values:\", df[\"Attrition\"].unique())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"8EsjethIcej-","executionInfo":{"status":"ok","timestamp":1795605794553,"user_tz":-180,"elapsed":9,"user":{"displayName":"Clare Nabwile","userId":"09967253055330741327"}},"outputId":"2b97343e-f786-4adf-9aeb-894a5d7e4519"},"execution_count":32,"outputs":[{"output_type":"stream","name":"stdout","text":["Attrition values in the dataset:\n","Attrition\n","0    1233\n","1     237\n","Name: count, dtype: int64\n","\n","Unique values: [1 0]\n"]}]},{"cell_type":"code","source":["# Calculate attrition rates for the K-Means clusters\n","\n","cluster_attrition = pd.DataFrame({\n","    \"Cluster\": cluster_labels,\n","    \"Attrition\": df[\"Attrition\"].values\n","})\n","\n","attrition_summary = cluster_attrition.groupby(\"Cluster\").agg(\n","    Employees=(\"Attrition\", \"count\"),\n","    Employees_Left=(\"Attrition\", \"sum\"),\n","    Attrition_Rate=(\"Attrition\", \"mean\")\n",")\n","\n","attrition_summary[\"Attrition_Rate\"] *= 100\n","\n","print(\"Attrition summary per K-Means cluster:\")\n","print(attrition_summary.round(2))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"6NhfIiNucmkq","executionInfo":{"status":"ok","timestamp":1795605821232,"user_tz":-180,"elapsed":96,"user":{"displayName":"Clare Nabwile","userId":"09967253055330741327"}},"outputId":"fada1cf5-c78d-4f44-d4b8-0dd7bbbe385a"},"execution_count":33,"outputs":[{"output_type":"stream","name":"stdout","text":["Attrition summary per K-Means cluster:\n","         Employees  Employees_Left  Attrition_Rate\n","Cluster                                           \n","0              317              29            9.15\n","1             1153             208           18.04\n"]}]},{"cell_type":"markdown","source":["Reinforcement Learning"],"metadata":{"id":"hca1IiXAdTD9"}},{"cell_type":"code","source":["# Check whether Gymnasium is available for the FrozenLake environment\n","\n","import gymnasium as gym\n","\n","print(\"Gymnasium version:\", gym.__version__)\n","print(\"FrozenLake environment is ready to be initialized.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"vA0P7gZXcvmu","executionInfo":{"status":"ok","timestamp":1795605858405,"user_tz":-180,"elapsed":448,"user":{"displayName":"Clare Nabwile","userId":"09967253055330741327"}},"outputId":"841f76c9-59f8-4301-8d18-096953c34008"},"execution_count":34,"outputs":[{"output_type":"stream","name":"stdout","text":["Gymnasium version: 1.4.0\n","FrozenLake environment is ready to be initialized.\n"]}]},{"cell_type":"code","source":["# Initialize FrozenLake with deterministic movement\n","\n","SEED = 823\n","\n","env = gym.make(\n","    \"FrozenLake-v1\",\n","    is_slippery=False\n",")\n","\n","state, info = env.reset(seed=SEED)\n","\n","# Get the environment dimensions\n","state_size = env.observation_space.n\n","action_size = env.action_space.n\n","\n","print(\"Environment: FrozenLake-v1\")\n","print(\"Slippery:\", False)\n","print(\"Seed:\", SEED)\n","print(\"Number of states:\", state_size)\n","print(\"Number of actions:\", action_size)\n","print(\"Initial state:\", state)\n","print(\"Action mapping:\", {0: \"Left\", 1: \"Down\", 2: \"Right\", 3: \"Up\"})"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ynanVYL5c__Q","executionInfo":{"status":"ok","timestamp":1795605924718,"user_tz":-180,"elapsed":50,"user":{"displayName":"Clare Nabwile","userId":"09967253055330741327"}},"outputId":"7d772795-3779-4c46-acdf-2d32b4d7cce6"},"execution_count":35,"outputs":[{"output_type":"stream","name":"stdout","text":["Environment: FrozenLake-v1\n","Slippery: False\n","Seed: 823\n","Number of states: 16\n","Number of actions: 4\n","Initial state: 0\n","Action mapping: {0: 'Left', 1: 'Down', 2: 'Right', 3: 'Up'}\n"]}]},{"cell_type":"code","source":["# Initialize Q-learning parameters and Q-table\n","\n","Q = np.zeros((state_size, action_size))\n","\n","alpha = 0.1       # Learning rate\n","gamma = 0.99      # Discount factor\n","epsilon = 1.0      # Initial exploration probability\n","epsilon_min = 0.01\n","epsilon_decay = 0.995\n","\n","episodes = 2000\n","\n","print(\"Q-table shape:\", Q.shape)\n","print(\"Learning rate (alpha):\", alpha)\n","print(\"Discount factor (gamma):\", gamma)\n","print(\"Initial epsilon:\", epsilon)\n","print(\"Minimum epsilon:\", epsilon_min)\n","print(\"Epsilon decay:\", epsilon_decay)\n","print(\"Training episodes:\", episodes)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"RhN88hAgdX-x","executionInfo":{"status":"ok","timestamp":1795606024202,"user_tz":-180,"elapsed":52,"user":{"displayName":"Clare Nabwile","userId":"09967253055330741327"}},"outputId":"4a897a69-a7be-48bd-bf1e-34e303b99056"},"execution_count":36,"outputs":[{"output_type":"stream","name":"stdout","text":["Q-table shape: (16, 4)\n","Learning rate (alpha): 0.1\n","Discount factor (gamma): 0.99\n","Initial epsilon: 1.0\n","Minimum epsilon: 0.01\n","Epsilon decay: 0.995\n","Training episodes: 2000\n"]}]},{"cell_type":"code","source":["# Train the Q-learning agent and record success rates every 100 episodes\n","\n","success_rates = []\n","episode_rewards = []\n","\n","for episode in range(episodes):\n","    state, info = env.reset()\n","    total_reward = 0\n","\n","    for step in range(100):\n","        # Epsilon-greedy action selection\n","        if np.random.random() < epsilon:\n","            action = env.action_space.sample()\n","        else:\n","            action = np.argmax(Q[state])\n","\n","        next_state, reward, terminated, truncated, info = env.step(action)\n","\n","        # Q-learning update\n","        Q[state, action] = Q[state, action] + alpha * (\n","            reward + gamma * np.max(Q[next_state]) - Q[state, action]\n","        )\n","\n","        state = next_state\n","        total_reward += reward\n","\n","        if terminated or truncated:\n","            break\n","\n","    episode_rewards.append(total_reward)\n","\n","    # Decay epsilon\n","    epsilon = max(epsilon_min, epsilon * epsilon_decay)\n","\n","    # Record success rate after every 100 episodes\n","    if (episode + 1) % 100 == 0:\n","        success_rate = np.mean(episode_rewards[-100:])\n","        success_rates.append(success_rate)\n","\n","print(\"Training completed.\")\n","print(\"Episodes:\", episodes)\n","print(\"Final epsilon:\", round(epsilon, 4))\n","print(\"Success rates per 100 episodes:\")\n","print(success_rates)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"zPzFSbMmde2P","executionInfo":{"status":"ok","timestamp":1795606060319,"user_tz":-180,"elapsed":8581,"user":{"displayName":"Clare Nabwile","userId":"09967253055330741327"}},"outputId":"a4217b33-28b1-4a12-bbcd-a99f52c09d54"},"execution_count":37,"outputs":[{"output_type":"stream","name":"stdout","text":["Training completed.\n","Episodes: 2000\n","Final epsilon: 0.01\n","Success rates per 100 episodes:\n","[np.float64(0.0), np.float64(0.0), np.float64(0.0), np.float64(0.0), np.float64(0.0), np.float64(0.0), np.float64(0.0), np.float64(0.0), np.float64(0.0), np.float64(0.0), np.float64(0.0), np.float64(0.0), np.float64(0.0), np.float64(0.0), np.float64(0.0), np.float64(0.0), np.float64(0.0), np.float64(0.0), np.float64(0.0), np.float64(0.0)]\n"]}]},{"cell_type":"code","source":["# Adjust exploration parameters to allow more exploration\n","\n","epsilon = 1.0\n","epsilon_min = 0.05\n","epsilon_decay = 0.9995\n","\n","# Reset the Q-table before retraining\n","Q = np.zeros((state_size, action_size))\n","\n","print(\"Q-table reset:\", Q.shape)\n","print(\"Initial epsilon:\", epsilon)\n","print(\"Minimum epsilon:\", epsilon_min)\n","print(\"Epsilon decay:\", epsilon_decay)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Xxa7mTvzdxpQ","executionInfo":{"status":"ok","timestamp":1795606128267,"user_tz":-180,"elapsed":55,"user":{"displayName":"Clare Nabwile","userId":"09967253055330741327"}},"outputId":"5bd3ed0c-9db2-4808-fb64-464dff1c0a7a"},"execution_count":38,"outputs":[{"output_type":"stream","name":"stdout","text":["Q-table reset: (16, 4)\n","Initial epsilon: 1.0\n","Minimum epsilon: 0.05\n","Epsilon decay: 0.9995\n"]}]},{"cell_type":"code","source":["# Retrain Q-learning with improved exploration\n","\n","np.random.seed(SEED)\n","env.action_space.seed(SEED)\n","\n","Q = np.zeros((state_size, action_size))\n","\n","alpha = 0.1\n","gamma = 0.99\n","epsilon = 1.0\n","epsilon_min = 0.05\n","epsilon_decay = 0.9995\n","episodes = 2000\n","\n","success_rates = []\n","episode_rewards = []\n","\n","for episode in range(episodes):\n","    state, info = env.reset()\n","    total_reward = 0\n","\n","    for step in range(100):\n","        # Epsilon-greedy action selection\n","        if np.random.random() < epsilon:\n","            action = env.action_space.sample()\n","        else:\n","            action = np.argmax(Q[state])\n","\n","        next_state, reward, terminated, truncated, info = env.step(action)\n","\n","        # Update Q-values\n","        Q[state, action] += alpha * (\n","            reward + gamma * np.max(Q[next_state]) - Q[state, action]\n","        )\n","\n","        state = next_state\n","        total_reward += reward\n","\n","        if terminated or truncated:\n","            break\n","\n","    episode_rewards.append(total_reward)\n","\n","    epsilon = max(epsilon_min, epsilon * epsilon_decay)\n","\n","    if (episode + 1) % 100 == 0:\n","        success_rates.append(np.mean(episode_rewards[-100:]))\n","\n","print(\"Training completed.\")\n","print(\"Episodes:\", episodes)\n","print(\"Final epsilon:\", round(epsilon, 4))\n","print(\"Success rates per 100 episodes:\")\n","print(np.round(success_rates, 3))\n","print(\"Total successful episodes:\", int(sum(episode_rewards)))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"rvV-j0Wod4WG","executionInfo":{"status":"ok","timestamp":1795606157389,"user_tz":-180,"elapsed":872,"user":{"displayName":"Clare Nabwile","userId":"09967253055330741327"}},"outputId":"850c5a66-ad46-493f-e98c-0f2b8e59aead"},"execution_count":39,"outputs":[{"output_type":"stream","name":"stdout","text":["Training completed.\n","Episodes: 2000\n","Final epsilon: 0.3678\n","Success rates per 100 episodes:\n","[0.02 0.04 0.08 0.07 0.1  0.1  0.14 0.16 0.21 0.16 0.27 0.37 0.46 0.33\n"," 0.4  0.47 0.53 0.45 0.48 0.54]\n","Total successful episodes: 538\n"]}]},{"cell_type":"code","source":["# Plot the success rate over training episodes\n","\n","plt.figure(figsize=(9, 5))\n","\n","episode_points = np.arange(100, episodes + 1, 100)\n","\n","plt.plot(episode_points, success_rates, marker=\"o\")\n","plt.title(\"Q-Learning Success Rate on FrozenLake (Non-Slippery)\")\n","plt.xlabel(\"Episodes\")\n","plt.ylabel(\"Success Rate\")\n","plt.xticks(episode_points, rotation=45)\n","plt.grid(alpha=0.3)\n","plt.tight_layout()\n","\n","plt.savefig(\n","    os.path.join(OUTPUT_DIR, \"success_rate.png\"),\n","    dpi=300,\n","    bbox_inches=\"tight\"\n",")\n","\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":507},"id":"i9e28DA2eA4I","executionInfo":{"status":"ok","timestamp":1795606194801,"user_tz":-180,"elapsed":4036,"user":{"displayName":"Clare Nabwile","userId":"09967253055330741327"}},"outputId":"352c4613-f7ec-4443-bd11-8cc5269a0736"},"execution_count":40,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 900x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Display the learned policy as arrows on the FrozenLake grid\n","\n","action_symbols = {\n","    0: \"←\",\n","    1: \"↓\",\n","    2: \"→\",\n","    3: \"↑\"\n","}\n","\n","lake_map = env.unwrapped.desc.astype(str)\n","\n","policy = np.argmax(Q, axis=1)\n","\n","print(\"Learned Policy (Non-Slippery FrozenLake):\\n\")\n","\n","for row in range(4):\n","    policy_row = []\n","    for col in range(4):\n","        state_index = row * 4 + col\n","        cell = lake_map[row, col]\n","\n","        if cell == \"H\":\n","            symbol = \"H\"\n","        elif cell == \"G\":\n","            symbol = \"G\"\n","        elif cell == \"S\":\n","            symbol = \"S\"\n","        else:\n","            symbol = action_symbols[policy[state_index]]\n","\n","        policy_row.append(symbol)\n","\n","    print(\" | \".join(policy_row))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"xb-fd177eJCN","executionInfo":{"status":"ok","timestamp":1795606224345,"user_tz":-180,"elapsed":53,"user":{"displayName":"Clare Nabwile","userId":"09967253055330741327"}},"outputId":"6f764588-5898-4b16-821b-c96df671f561"},"execution_count":41,"outputs":[{"output_type":"stream","name":"stdout","text":["Learned Policy (Non-Slippery FrozenLake):\n","\n","S | → | ↓ | ←\n","↓ | H | ↓ | H\n","→ | ↓ | ↓ | H\n","H | → | → | G\n"]}]},{"cell_type":"code","source":["# Train Q-learning on Slippery FrozenLake\n","\n","env_slippery = gym.make(\"FrozenLake-v1\", is_slippery=True)\n","\n","env_slippery.action_space.seed(SEED)\n","np.random.seed(SEED)\n","\n","Q_slippery = np.zeros((state_size, action_size))\n","\n","alpha = 0.1\n","gamma = 0.99\n","epsilon = 1.0\n","epsilon_min = 0.05\n","epsilon_decay = 0.9995\n","episodes = 2000\n","\n","success_rates_slippery = []\n","episode_rewards_slippery = []\n","\n","for episode in range(episodes):\n","    state, info = env_slippery.reset(seed=SEED if episode == 0 else None)\n","    total_reward = 0\n","\n","    for step in range(100):\n","        # Epsilon-greedy action selection\n","        if np.random.random() < epsilon:\n","            action = env_slippery.action_space.sample()\n","        else:\n","            action = np.argmax(Q_slippery[state])\n","\n","        next_state, reward, terminated, truncated, info = env_slippery.step(action)\n","\n","        # Q-learning update\n","        Q_slippery[state, action] += alpha * (\n","            reward + gamma * np.max(Q_slippery[next_state])\n","            - Q_slippery[state, action]\n","        )\n","\n","        state = next_state\n","        total_reward += reward\n","\n","        if terminated or truncated:\n","            break\n","\n","    episode_rewards_slippery.append(total_reward)\n","\n","    epsilon = max(epsilon_min, epsilon * epsilon_decay)\n","\n","    # Record success rate every 100 episodes\n","    if (episode + 1) % 100 == 0:\n","        success_rate = np.mean(episode_rewards_slippery[-100:])\n","        success_rates_slippery.append(success_rate)\n","\n","print(\"Slippery FrozenLake training completed.\")\n","print(\"Episodes:\", episodes)\n","print(\"Final epsilon:\", round(epsilon, 4))\n","print(\"Success rates per 100 episodes:\")\n","print(np.round(success_rates_slippery, 2))\n","print(\"Total successful episodes:\", int(sum(episode_rewards_slippery)))\n","print(\"Overall success rate:\", round(np.mean(episode_rewards_slippery) * 100, 2), \"%\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"NiDTGOvSeSMU","executionInfo":{"status":"ok","timestamp":1795606264924,"user_tz":-180,"elapsed":1301,"user":{"displayName":"Clare Nabwile","userId":"09967253055330741327"}},"outputId":"f7147490-5f3c-478f-a90f-0c5d3ba9f1c6"},"execution_count":42,"outputs":[{"output_type":"stream","name":"stdout","text":["Slippery FrozenLake training completed.\n","Episodes: 2000\n","Final epsilon: 0.3678\n","Success rates per 100 episodes:\n","[0.01 0.03 0.01 0.03 0.   0.03 0.02 0.05 0.06 0.06 0.03 0.07 0.03 0.09\n"," 0.04 0.06 0.05 0.07 0.1  0.12]\n","Total successful episodes: 96\n","Overall success rate: 4.8 %\n"]}]},{"cell_type":"code","source":["# Define the policy printing function again\n","\n","def print_policy(Q_table, environment):\n","    desc = environment.unwrapped.desc\n","    arrows = {0: \"←\", 1: \"↓\", 2: \"→\", 3: \"↑\"}\n","\n","    for row in range(4):\n","        cells = []\n","        for col in range(4):\n","            state = row * 4 + col\n","            tile = desc[row, col].decode()\n","\n","            if tile in (\"H\", \"G\"):\n","                cells.append(tile)\n","            else:\n","                cells.append(arrows[int(np.argmax(Q_table[state]))])\n","\n","        print(\" | \".join(cells))\n","\n","\n","# Print the slippery environment's learned policy\n","print(\"Learned Policy (Slippery FrozenLake):\\n\")\n","print_policy(Q_slippery, env_slippery)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"RsfFw0D_erdi","executionInfo":{"status":"ok","timestamp":1795606365979,"user_tz":-180,"elapsed":55,"user":{"displayName":"Clare Nabwile","userId":"09967253055330741327"}},"outputId":"d6dd901c-3804-41fd-f5c9-91cc1d415242"},"execution_count":45,"outputs":[{"output_type":"stream","name":"stdout","text":["Learned Policy (Slippery FrozenLake):\n","\n","← | ↑ | ↑ | ↑\n","← | H | ← | H\n","↑ | ↓ | ← | H\n","H | → | ↓ | G\n"]}]},{"cell_type":"code","source":["# Demonstrate one Q-learning update using a transition into the goal\n","\n","Q_example = Q.copy()\n","\n","# State 14: one step before the goal\n","state = 14\n","action = 2  # Right\n","\n","# Get the actual transition from FrozenLake\n","transition = env.unwrapped.P[state][action][0]\n","\n","probability, next_state, reward, terminated = transition\n","\n","q_before = Q_example[state, action]\n","best_next_q = 0 if terminated else np.max(Q_example[next_state])\n","\n","# Apply Q-learning update\n","q_after = q_before + alpha * (\n","    reward + gamma * best_next_q - q_before\n",")\n","\n","Q_example[state, action] = q_after\n","\n","print(\"Q-Learning Update Demonstration\")\n","print(\"--------------------------------\")\n","print(f\"Current state: {state}\")\n","print(f\"Action: Right ({action})\")\n","print(f\"Next state: {next_state}\")\n","print(f\"Reward: {reward}\")\n","print(f\"Q before update: {q_before:.6f}\")\n","print(f\"Best next Q-value: {best_next_q:.6f}\")\n","print(f\"Q after update: {q_after:.6f}\")\n","print(f\"Learning rate (alpha): {alpha}\")\n","print(f\"Discount factor (gamma): {gamma}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"HsJBkkc1e0WQ","executionInfo":{"status":"ok","timestamp":1795606402109,"user_tz":-180,"elapsed":51,"user":{"displayName":"Clare Nabwile","userId":"09967253055330741327"}},"outputId":"932aa22d-255d-4cfc-8ed8-501ec6e53c7c"},"execution_count":46,"outputs":[{"output_type":"stream","name":"stdout","text":["Q-Learning Update Demonstration\n","--------------------------------\n","Current state: 14\n","Action: Right (2)\n","Next state: 15\n","Reward: 1\n","Q before update: 1.000000\n","Best next Q-value: 0.000000\n","Q after update: 1.000000\n","Learning rate (alpha): 0.1\n","Discount factor (gamma): 0.99\n"]}]},{"cell_type":"markdown","source":["### Q-learning Written Analysis\n","\n","**1. Interpretation of employee clusters**\n","\n","K-Means identified two employee clusters. Cluster 0 represents older, higher-income employees with longer years of service and a lower attrition rate of 9.15%. Cluster 1 represents younger, lower-income employees with shorter tenure and a higher attrition rate of 18.04%. This suggests that younger and shorter-serving employees may require more support in employee retention.\n","\n","**2. Learning rate (α)**\n","\n","The learning rate controls how much new information influences existing Q-values. A high learning rate allows faster learning but may cause instability, while a low learning rate produces gradual learning. In this experiment, α = 0.1 allows the agent to update its knowledge gradually.\n","\n","**3. Discount factor (γ)**\n","\n","The discount factor determines the importance of future rewards. A value close to 1 encourages the agent to consider long-term rewards, while a value closer to 0 prioritizes immediate rewards. The experiment used γ = 0.99, encouraging the agent to learn paths that eventually reach the goal.\n","\n","**4. Exploration rate (ε)**\n","\n","Epsilon controls exploration versus exploitation. During exploration, the agent selects random actions to discover new paths. During exploitation, it selects the action with the highest learned Q-value. Epsilon was initially set to 1.0 and gradually reduced using a decay rate of 0.9995, with a minimum of 0.05.\n","\n","**5. Why the slippery environment is harder**\n","\n","The slippery FrozenLake environment is harder because actions do not always produce the intended movement. The agent may slide in another direction and fall into a hole despite selecting the correct action. This increases uncertainty and makes learning a successful policy more difficult. The success rate was 26.9% in the non-slippery environment and 4.8% in the slippery environment, demonstrating the impact of unpredictable transitions on learning performance."],"metadata":{"id":"FNSlqXlNe888"}},{"cell_type":"code","source":["# Final verification of Task 7 requirements\n","\n","required_variables = [\n","    \"inertias\",\n","    \"sil_scores\",\n","    \"best_k\",\n","    \"pca\",\n","    \"dbscan_labels\",\n","    \"Q\",\n","    \"success_rates\"\n","]\n","\n","print(\"VARIABLE VERIFICATION\")\n","print(\"-\" * 40)\n","\n","for var in required_variables:\n","    exists = var in globals()\n","    print(f\"{var}: {'OK' if exists else 'MISSING'}\")\n","\n","print(\"\\nOUTPUT FILE VERIFICATION\")\n","print(\"-\" * 40)\n","\n","required_files = [\n","    \"elbow.png\",\n","    \"pca_clusters.png\",\n","    \"success_rate.png\"\n","]\n","\n","for file in required_files:\n","    path = os.path.join(OUTPUT_DIR, file)\n","    print(f\"{file}: {'OK' if os.path.exists(path) else 'MISSING'}\")\n","\n","print(\"\\nTask 7 verification completed.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"1vtbx3K4fDtc","executionInfo":{"status":"ok","timestamp":1795606465611,"user_tz":-180,"elapsed":47,"user":{"displayName":"Clare Nabwile","userId":"09967253055330741327"}},"outputId":"7546f6f5-0059-469a-a55b-a9585f4ebedf"},"execution_count":47,"outputs":[{"output_type":"stream","name":"stdout","text":["VARIABLE VERIFICATION\n","----------------------------------------\n","inertias: OK\n","sil_scores: OK\n","best_k: OK\n","pca: OK\n","dbscan_labels: OK\n","Q: OK\n","success_rates: OK\n","\n","OUTPUT FILE VERIFICATION\n","----------------------------------------\n","elbow.png: OK\n","pca_clusters.png: OK\n","success_rate.png: OK\n","\n","Task 7 verification completed.\n"]}]}]}