,"        docLink.innerHTML = docLinkHtml;\n","        element.appendChild(docLink);\n","      }\n","    </script>\n","  </div>\n","\n","\n","    </div>\n","  </div>\n"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"dataframe","summary":"{\n  \"name\": \"display(attrition_rates\",\n  \"rows\": 2,\n  \"fields\": [\n    {\n      \"column\": \"Cluster\",\n      \"properties\": {\n        \"dtype\": \"int32\",\n        \"num_unique_values\": 2,\n        \"samples\": [\n          1,\n          0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Attrition Rate (%)\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 7.764032457428293,\n        \"min\": 7.96,\n        \"max\": 18.94,\n        \"num_unique_values\": 2,\n        \"samples\": [\n          18.94,\n          7.96\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}}]},{"cell_type":"code","source":["# Select and scale the five required features for K-Means\n","\n","kmeans_features = [\n","    \"Age\",\n","    \"MonthlyIncome\",\n","    \"YearsAtCompany\",\n","    \"DistanceFromHome\",\n","    \"JobSatisfaction\"\n","]\n","\n","X_kmeans = df[kmeans_features].copy()\n","\n","scaler = StandardScaler()\n","X_scaled = scaler.fit_transform(X_kmeans)\n","\n","print(\"Features selected for K-Means:\")\n","print(kmeans_features)\n","\n","print(\"\\nScaled data shape:\", X_scaled.shape)\n","print(\"Mean:\", round(X_scaled.mean(), 4))\n","print(\"Standard deviation:\", round(X_scaled.std(), 4))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"xdMD-XMKZ-0T","executionInfo":{"status":"ok","timestamp":1795605133736,"user_tz":-180,"elapsed":43,"user":{"displayName":"Clare Nabwile","userId":"09967253055330741327"}},"outputId":"337b499e-fb06-4d48-8600-bf980cc3bd92"},"execution_count":20,"outputs":[{"output_type":"stream","name":"stdout","text":["Features selected for K-Means:\n","['Age', 'MonthlyIncome', 'YearsAtCompany', 'DistanceFromHome', 'JobSatisfaction']\n","\n","Scaled data shape: (1470, 5)\n","Mean: -0.0\n","Standard deviation: 1.0\n"]}]},{"cell_type":"code","source":["# Evaluate K-Means for different cluster numbers using inertia and silhouette scores\n","\n","inertias = []\n","sil_scores = []\n","k_values = range(2, 11)\n","\n","for k in k_values:\n","    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)\n","    labels = kmeans.fit_predict(X_scaled)\n","\n","    inertias.append(kmeans.inertia_)\n","    sil_scores.append(silhouette_score(X_scaled, labels))\n","\n","# Plot the elbow curve\n","plt.figure(figsize=(8, 5))\n","plt.plot(k_values, inertias, marker=\"o\")\n","plt.title(\"Elbow Method for K-Means Clustering\")\n","plt.xlabel(\"Number of Clusters (K)\")\n","plt.ylabel(\"Inertia\")\n","plt.xticks(list(k_values))\n","plt.grid(alpha=0.3)\n","plt.tight_layout()\n","\n","# Save required output\n","OUTPUT_DIR = \"/content/drive/MyDrive/CSC4110_G09/outputs\"\n","os.makedirs(OUTPUT_DIR, exist_ok=True)\n","plt.savefig(os.path.join(OUTPUT_DIR, \"elbow.png\"), dpi=300, bbox_inches=\"tight\")\n","plt.show()\n","\n","# Display silhouette scores\n","silhouette_results = pd.DataFrame({\n","    \"K\": list(k_values),\n","    \"Inertia\": inertias,\n","    \"Silhouette Score\": sil_scores\n","})\n","\n","display(silhouette_results.round(4))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":821},"id":"zcC1eR-uaIAx","executionInfo":{"status":"ok","timestamp":1795605174750,"user_tz":-180,"elapsed":1877,"user":{"displayName":"Clare Nabwile","userId":"09967253055330741327"}},"outputId":"54c0354f-ba33-4989-adac-b00444d60b6c"},"execution_count":21,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["    K    Inertia  Silhouette Score\n","0   2  551