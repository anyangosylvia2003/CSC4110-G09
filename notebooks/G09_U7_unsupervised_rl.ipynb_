values\": 19,\n        \"samples\": [\n          60.0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}}]},{"cell_type":"code","source":["# Prepare features for clustering\n","\n","# Exclude target and identifier columns\n","excluded_columns = [\"Attrition\", \"EmployeeNumber\"]\n","\n","X_cluster = df.drop(\n","    columns=[col for col in excluded_columns if col in df.columns]\n",").copy()\n","\n","# Remove constant columns\n","constant_columns = [\n","    col for col in X_cluster.columns\n","    if X_cluster[col].nunique() <= 1\n","]\n","\n","X_cluster = X_cluster.drop(columns=constant_columns)\n","\n","# Identify numerical and categorical features\n","numeric_features = X_cluster.select_dtypes(include=np.number).columns.tolist()\n","categorical_features = X_cluster.select_dtypes(exclude=np.number).columns.tolist()\n","\n","print(\"Features prepared for clustering.\")\n","print(\"=\" * 45)\n","print(\"Numerical features:\", len(numeric_features))\n","print(\"Categorical features:\", len(categorical_features))\n","print(\"Constant columns removed:\", constant_columns)\n","print(\"Total selected features:\", X_cluster.shape[1])\n","\n","display(X_cluster.head())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":377},"id":"loPzKAfGXNOE","executionInfo":{"status":"ok","timestamp":1795604406540,"user_tz":-180,"elapsed":76,"user":{"displayName":"Clare Nabwile","userId":"09967253055330741327"}},"outputId":"21a5eb5e-c9f8-428d-aaf0-bb3db15afc84"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["Features prepared for clustering.\n","=============================================\n","Numerical features: 49\n","Categorical features: 1\n","Constant columns removed: []\n","Total selected features: 50\n"]},{"output_type":"display_data","data":{"text/plain":["   Age  BusinessTravel  DailyRate  DistanceFromHome  Education  \\\n","0   41               1       1102   