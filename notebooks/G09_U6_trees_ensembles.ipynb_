{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[]},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"markdown","source":["Task 6: Decision Trees and Ensembles\n","\n","Task Owner: Obed Kiprono (Member 5)\n","\n","Dataset: IBM HR Analytics Employee Attrition Dataset\n","\n","Classification Target: Attrition\n","\n","Objective: Build and evaluate decision trees, random forests and gradient boosting models to predict employee attrition."],"metadata":{"id":"PGkWpc8MJFWX"}},{"cell_type":"code","execution_count":1,"metadata":{"id":"76MMbgJxHRZ0","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1795610136988,"user_tz":480,"elapsed":45031,"user":{"displayName":"Otuko Jack","userId":"08583356222525555535"}},"outputId":"bdc44d4b-c223-411e-ce2a-f4e7d039a960"},"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n","Dataset loaded successfully.\n","Training data: (1176, 30)\n","Testing data: (294, 30)\n","\n","Target distribution:\n","Attrition\n","0    1233\n","1     237\n","Name: count, dtype: int64\n"]}],"source":["# Import required libraries\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","\n","from google.colab import drive\n","from sklearn.model_selection import train_test_split\n","\n","# Connect Google Drive\n","drive.mount('/content/drive')\n","\n","# Load dataset\n","file_path = \"/content/drive/MyDrive/CSC4110_G09/data/WA_Fn-UseC_-HR-Employee-Attrition.csv\"\n","\n","df = pd.read_csv(file_path)\n","\n","# Remove irrelevant columns\n","df = df.drop(columns=[\n","    \"EmployeeNumber\",\n","    \"EmployeeCount\",\n","    \"Over18\",\n","    \"StandardHours\"\n","])\n","\n","# Separate features and target\n","X = df.drop(columns=[\"Attrition\"])\n","y = df[\"Attrition\"].map({\"No\": 0, \"Yes\": 1})\n","\n","# Split data into training and testing sets\n","X_train, X_test, y_train, y_test = train_test_split(\n","    X,\n","    y,\n","    test_size=0.20,\n","    random_state=42,\n","    stratify=y\n",")\n","\n","print(\"Dataset loaded successfully.\")\n","print(\"Training data:\", X_train.shape)\n","print(\"Testing data:\", X_test.shape)\n","print(\"\\nTarget distribution:\")\n","print(y.value_counts())"]},{"cell_type":"code","source":["from sklearn.compose import ColumnTransformer\n","from sklearn.preprocessing import OneHotEncoder\n","\n","# Identify numerical and categorical columns\n","numeric_features = X_train.select_dtypes(include=[\"int64\", \"float64\"]).columns\n","categorical_features = X_train.select_dtypes(include=[\"object\"]).columns\n","\n","# Create preprocessing transformer\n","preprocessor = ColumnTransformer(\n","    transformers=[\n","        (\"num\", \"passthrough\", numeric_features),\n","        (\"cat\", OneHotEncoder(handle_unknown=\"ignore\"), categorical_features)\n","    ]\n",")\n","\n","# Fit on training data and transform both datasets\n","X_train_processed = preprocessor.fit_transform(X_train)\n","X_test_processed = preprocessor.transform(X_test)\n","\n","print(\"Preprocessing completed.\")\n","print(\"Training shape:\", X_train_processed.shape)\n","print(\"Testing shape:\", X_test_processed.shape)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"FdU6621FMzI6","executionInfo":{"status":"ok","timestamp":1795610137206,"user_tz":480,"elapsed":211,"user":{"displayName":"Otuko Jack","userId":"08583356222525555535"}},"outputId":"b793ca49-bcc5-40ee-81ec-7dcca66d8c1a"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["Preprocessing completed.\n","Training shape: (1176, 51)\n","Testing shape: (294, 51)\n"]}]},{"cell_type":"code","source":["from sklearn.tree import DecisionTreeClassifier\n","\n","# Create decision tree\n","tree3 = DecisionTreeClassifier(\n","    max_depth=3,\n","    criterion=\"entropy\",\n","    random_state=42\n",")\n","\n","# Train the model\n","tree3.fit(X_train_processed, y_train)\n","\n","# Evaluate accuracy\n","tree3_train_accuracy = tree3.score(X_train_processed, y_train)\n","tree3_test_accuracy = tree3.score(X_test_processed, y_test)\n","\n","print(\"Decision tree trained successfully.\")\n","print(\"Training accuracy:\", round(tree3_train_accuracy, 4))\n","print(\"Testing accuracy:\", round(tree3_test_accuracy, 4))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"_Otb30VSNE7G","executionInfo":{"status":"ok","timestamp":1795610137216,"user_tz":480,"elapsed":8,"user":{"displayName":"Otuko Jack","userId":"08583356222525555535"}},"outputId":"9ac8d670-b90d-41ed-ce4c-bef5d2f5723d"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["Decision tree trained successfully.\n","Training accuracy: 0.8682\n","Testing accuracy: 0.8299\n"]}]},{"cell_type":"code","source":["from sklearn.tree import plot_tree\n","import os\n","\n","# Create output folder if it does not exist\n","output_folder = \"/content/drive/MyDrive/CSC4110_G09/outputs\"\n","os.makedirs(output_folder, exist_ok=True)\n","\n","# Get transformed feature names\n","feature_names = preprocessor.get_feature_names_out()\n","\n","# Plot decision tree\n","plt.figure(figsize=(24, 12))\n","\n","plot_tree(\n","    tree3,\n","    feature_names=feature_names,\n","    class_names=[\"Stayed\", \"Left\"],\n","    filled=True,\n","    rounded=True,\n","    fontsize=8\n",")\n","\n","plt.title(\"Decision Tree - Maximum Depth 3\")\n","plt.savefig(\n","    os.path.join(output_folder, \"tree_depth3.png\"),\n","    dpi=300,\n","    bbox_inches=\"tight\"\n",")\n","plt.show()\n","\n","print(\"Decision tree saved successfully.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":592},"id":"g32pDOFyNQEj","executionInfo":{"status":"ok","timestamp":1795610147385,"user_tz":480,"elapsed":10166,"user":{"displayName":"Otuko Jack","userId":"08583356222525555535"}},"outputId":"240d7af1-84c2-4392-cf9d-064eab837336"},"execution_count":4,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 2400x1200 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Decision tree saved successfully.\n"]}]},{"cell_type":"code","source":["# Get the root node's feature and threshold\n","root_feature_index = tree3.tree_.feature[0]\n","root_threshold = tree3.tree_.threshold[0]\n","\n","root_feature = feature_names[root_feature_index]\n","\n","print(\"Top split feature:\", root_feature)\n","print(\"Top split threshold:\", round(root_threshold, 4))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"owHeUT9hOMl6","executionInfo":{"status":"ok","timestamp":1795610147455,"user_tz":480,"elapsed":27,"user":{"displayName":"Otuko Jack","userId":"08583356222525555535"}},"outputId":"cb75b1b2-83a6-4098-fa70-2c10f4483429"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["Top split feature: num__TotalWorkingYears\n","Top split threshold: 2.5\n"]}]},{"cell_type":"markdown","source":["### Interpretation of the Top Split\n","\n","The first split in the decision tree is based on `TotalWorkingYears`, with a threshold of 2.5 years. The model separates employees with 2.5 or fewer total working years from those with more than 2.5 years.\n","\n","This indicates that total work experience is an important factor in the tree's first decision when predicting employee attrition. However, this split alone does not prove that employees with less experience are more likely to leave; the prediction depends on the branches and class distributions below the split."],"metadata":{"id":"GO79FXCeOdMO"}},{"cell_type":"code","source":["from sklearn.tree import DecisionTreeClassifier\n","\n","depth_results = []\n","\n","for depth in range(1, 16):\n","    tree = DecisionTreeClassifier(\n","        max_depth=depth,\n","        criterion=\"entropy\",\n","        random_state=42\n","    )\n","\n","    tree.fit(X_train_processed, y_train)\n","\n","    train_accuracy = tree.score(X_train_processed, y_train)\n","    test_accuracy = tree.score(X_test_processed, y_test)\n","\n","    depth_results.append({\n","        \"Depth\": depth,\n","        \"Training Accuracy\": train_accuracy,\n","        \"Testing Accuracy\": test_accuracy\n","    })\n","\n","depth_results = pd.DataFrame(depth_results)\n","\n","print(depth_results.round(4).to_string(index=False))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"tMV2nQhvOm9h","executionInfo":{"status":"ok","timestamp":1795610148061,"user_tz":480,"elapsed":492,"user":{"displayName":"Otuko Jack","userId":"08583356222525555535"}},"outputId":"e3cc0f6d-2ca9-41c8-a5eb-03ede78ef73e"},"execution_count":6,"outputs":[{"output_type":"stream","name":"stdout","text":[" Depth  Training Accuracy  Testing Accuracy\n","     1             0.8401            0.7823\n","     2             0.8529            0.8027\n","     3             0.8682            0.8299\n","     4             0.8724            0.8129\n","     5             0.8869            0.8197\n","     6             0.9048            0.8163\n","     7             0.9243            0.8197\n","     8             0.9430            0.8265\n","     9             0.9634            0.8027\n","    10             0.9762            0.8095\n","    11             0.9855            0.7959\n","    12             0.9898            0.7891\n","    13             0.9991            0.7755\n","    14             1.0000            0.7823\n","    15             1.0000            0.7823\n"]}]},{"cell_type":"code","source":["plt.figure(figsize=(10, 6))\n","\n","plt.plot(\n","    depth_results[\"Depth\"],\n","    depth_results[\"Training Accuracy\"],\n","    marker=\"o\",\n","    label=\"Training Accuracy\"\n",")\n","\n","plt.plot(\n","    depth_results[\"Depth\"],\n","    depth_results[\"Testing Accuracy\"],\n","    marker=\"o\",\n","    label=\"Testing Accuracy\"\n",")\n","\n","plt.xlabel(\"Tree Depth\")\n","plt.ylabel(\"Accuracy\")\n","plt.title(\"Decision Tree: Training vs Testing Accuracy\")\n","plt.xticks(range(1, 16))\n","plt.legend()\n","plt.grid(True)\n","\n","plt.savefig(\n","    os.path.join(output_folder, \"depth_curve.png\"),\n","    dpi=300,\n","    bbox_inches=\"tight\"\n",")\n","\n","plt.show()\n","\n","print(\"Depth curve saved successfully.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":581},"id":"ormYGIOpPAME","executionInfo":{"status":"ok","timestamp":1795610150451,"user_tz":480,"elapsed":2379,"user":{"displayName":"Otuko Jack","userId":"08583356222525555535"}},"outputId":"c900ea88-4bb1-4e43-a2ce-e1043c9d8a41"},"execution_count":7,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Depth curve saved successfully.\n"]}]},{"cell_type":"markdown","source":["### Written Answer: Decision Tree Overfitting\n","\n","The decision tree starts showing signs of overfitting at approximately depth 4. At depth 3, the model achieves its highest testing accuracy of 82.99%. As the depth increases, training accuracy continues to improve, eventually reaching 100%, while testing accuracy generally decreases.\n","\n","This means deeper trees learn the training data very closely, including patterns that may not generalise to new employees. Therefore, a maximum depth of 3 provides the best testing accuracy among the depths evaluated."],"metadata":{"id":"YcxVwdRdPNqy"}},{"cell_type":"code","source":["from math import log2\n","\n","def entropy(y):\n","    probabilities = np.bincount(y) / len(y)\n","\n","    return -sum(\n","        p * log2(p)\n","        for p in probabilities\n","        if p > 0\n","    )\n","\n","\n","def information_gain(y_parent, y_left, y_right):\n","    parent_entropy = entropy(y_parent)\n","\n","    left_weight = len(y_left) / len(y_parent)\n","    right_weight = len(y_right) / len(y_parent)\n","\n","    children_entropy = (\n","        left_weight * entropy(y_left)\n","        + right_weight * entropy(y_right)\n","    )\n","\n","    return parent_entropy - children_entropy\n","\n","\n","print(\"Entropy and information gain functions created.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"HRAh-avuPPot","executionInfo":{"status":"ok","timestamp":1795610150527,"user_tz":480,"elapsed":21,"user":{"displayName":"Otuko Jack","userId":"08583356222525555535"}},"outputId":"6bb9ea39-0214-4f72-de4a-0605be6b6dda"},"execution_count":8,"outputs":[{"output_type":"stream","name":"stdout","text":["Entropy and information gain functions created.\n"]}]},{"cell_type":"code","source":["# Get the original TotalWorkingYears column\n","working_years = X_train[\"TotalWorkingYears\"].values\n","\n","# Divide employees using the tree's root threshold\n","left_mask = working_years <= root_threshold\n","right_mask = working_years > root_threshold\n","\n","# Get target values for each branch\n","y_parent = y_train.values\n","y_left = y_parent[left_mask]\n","y_right = y_parent[right_mask]\n","\n","# Calculate root information gain\n","ig_root = information_gain(\n","    y_parent,\n","    y_left,\n","    y_right\n",")\n","\n","print(\"Root split: TotalWorkingYears <=\", root_threshold)\n","print(\"Parent entropy:\", round(entropy(y_parent), 4))\n","print(\"Left group size:\", len(y_left))\n","print(\"Right group size:\", len(y_right))\n","print(\"Root information gain:\", round(ig_root, 4))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"40_rXPXoPhms","executionInfo":{"status":"ok","timestamp":1795610150725,"user_tz":480,"elapsed":164,"user":{"displayName":"Otuko Jack","userId":"08583356222525555535"}},"outputId":"b1e32cd9-b749-4670-fc7d-0e5a7831f304"},"execution_count":9,"outputs":[{"output_type":"stream","name":"stdout","text":["Root split: TotalWorkingYears <= 2.5\n","Parent entropy: 0.638\n","Left group size: 96\n","Right group size: 1080\n","Root information gain: 0.0431\n"]}]},{"cell_type":"code","source":["# Calculate median age from training data\n","age_median = X_train[\"Age\"].median()\n","\n","# Split employees by median age\n","age_left_mask = X_train[\"Age\"] <= age_median\n","age_right_mask = X_train[\"Age\"] > age_median\n","\n","# Get target values for both groups\n","y_age_left = y_train.values[age_left_mask]\n","y_age_right = y_train.values[age_right_mask]\n","\n","# Calculate information gain for Age split\n","ig_age = information_gain(\n","    y_train.values,\n","    y_age_left,\n","    y_age_right\n",")\n","\n","print(\"Median Age:\", age_median)\n","print(\"Age split information gain:\", round(ig_age, 4))\n","print(\"Root split information gain:\", round(ig_root, 4))\n","\n","if ig_root > ig_age:\n","    print(\"The tree's root split has higher information gain.\")\n","else:\n","    print(\"The Age split has equal or higher information gain.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"6c6RYyzfPyue","executionInfo":{"status":"ok","timestamp":1795610150759,"user_tz":480,"elapsed":11,"user":{"displayName":"Otuko Jack","userId":"08583356222525555535"}},"outputId":"5919002a-736f-4791-9d50-912bb5e7cb05"},"execution_count":10,"outputs":[{"output_type":"stream","name":"stdout","text":["Median Age: 36.0\n","Age split information gain: 0.0187\n","Root split information gain: 0.0431\n","The tree's root split has higher information gain.\n"]}]},{"cell_type":"markdown","source":["### Information Gain Comparison\n","\n","The decision tree's first split on `TotalWorkingYears` has an information gain of 0.0431, while splitting on `Age` at its median of 36 years gives an information gain of 0.0187.\n","\n","Therefore, the root split provides more information about employee attrition than the Age split. This supports the tree's choice of `TotalWorkingYears` as its first splitting feature."],"metadata":{"id":"VJ052snYQO_6"}},{"cell_type":"code","source":["from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier\n","from sklearn.metrics import accuracy_score, f1_score\n","\n","# Train Random Forest\n","forest = RandomForestClassifier(\n","    n_estimators=100,\n","    random_state=42,\n","    class_weight=\"balanced\"\n",")\n","\n","forest.fit(X_train_processed, y_train)\n","\n","# Train Gradient Boosting\n","boosting = GradientBoostingClassifier(\n","    n_estimators=100,\n","    learning_rate=0.1,\n","    max_depth=3,\n","    random_state=42\n",")\n","\n","boosting.fit(X_train_processed, y_train)\n","\n","print(\"Random Forest and Gradient Boosting trained successfully.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"0cRSLTqLQQjC","executionInfo":{"status":"ok","timestamp":1795610150831,"user_tz":480,"elapsed":12,"user":{"displayName":"Otuko Jack","userId":"08583356222525555535"}},"outputId":"53f45571-c2c9-427a-c02b-b91c60824eb4"},"execution_count":11,"outputs":[{"output_type":"stream","name":"stdout","text":["Random Forest and Gradient Boosting trained successfully.\n"]}]},{"cell_type":"code","source":["from sklearn.metrics import accuracy_score, f1_score\n","\n","models = {\n","    \"Decision Tree\": tree3,\n","    \"Random Forest\": forest,\n","    \"Gradient Boosting\": boosting\n","}\n","\n","results_trees = []\n","\n","for name, model in models.items():\n","    predictions = model.predict(X_test_processed)\n","\n","    accuracy = accuracy_score(y_test, predictions)\n","    f1 = f1_score(y_test, predictions)\n","\n","    results_trees.append({\n","        \"Model\": name,\n","        \"Test Accuracy\": accuracy,\n","        \"F1 Score\": f1\n","    })\n","\n","results_trees = pd.DataFrame(results_trees)\n","\n","print(results_trees.round(4).to_string(index=False))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"WMJp98OMQeIi","executionInfo":{"status":"ok","timestamp":1795610150850,"user_tz":480,"elapsed":15,"user":{"displayName":"Otuko Jack","userId":"08583356222525555535"}},"outputId":"e92a5991-a3ef-4162-af65-755b97610707"},"execution_count":12,"outputs":[{"output_type":"stream","name":"stdout","text":["            Model  Test Accuracy  F1 Score\n","    Decision Tree         0.8299    0.3243\n","    Random Forest         0.8469    0.1818\n","Gradient Boosting         0.8605    0.3279\n"]}]},{"cell_type":"code","source":["# Get feature importance values\n","importances = pd.DataFrame({\n","    \"Feature\": feature_names,\n","    \"Importance\": forest.feature_importances_\n","})\n","\n","# Sort features by importance\n","importances = importances.sort_values(\n","    by=\"Importance\",\n","    ascending=False\n",")\n","\n","# Display top 10 features\n","print(importances.head(10).round(4).to_string(index=False))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"IJ593C6BQnN6","executionInfo":{"status":"ok","timestamp":1795610150913,"user_tz":480,"elapsed":61,"user":{"displayName":"Otuko Jack","userId":"08583356222525555535"}},"outputId":"d0f9c24e-3047-41d2-bc91-04eee7ddf72a"},"execution_count":13,"outputs":[{"output_type":"stream","name":"stdout","text":["                  Feature  Importance\n","       num__MonthlyIncome      0.0679\n","   num__TotalWorkingYears      0.0614\n","                 num__Age      0.0578\n","           num__DailyRate      0.0498\n","    num__DistanceFromHome      0.0448\n","         num__MonthlyRate      0.0437\n","          num__HourlyRate      0.0437\n","      num__YearsAtCompany      0.0433\n","  num__NumCompaniesWorked      0.0386\n","num__YearsWithCurrManager      0.0376\n"]}]},{"cell_type":"code","source":["# Select top 10 features\n","top10 = importances.head(10).sort_values(\n","    by=\"Importance\",\n","    ascending=True\n",")\n","\n","# Plot feature importance\n","plt.figure(figsize=(10, 6))\n","\n","plt.barh(\n","    top10[\"Feature\"],\n","    top10[\"Importance\"]\n",")\n","\n","plt.xlabel(\"Importance\")\n","plt.ylabel(\"Feature\")\n","plt.title(\"Top 10 Random Forest Feature Importances\")\n","\n","plt.tight_layout()\n","\n","plt.savefig(\n","    os.path.join(output_folder, \"feature_importance.png\"),\n","    dpi=300,\n","    bbox_inches=\"tight\"\n",")\n","\n","plt.show()\n","\n","print(\"Feature importance graph saved successfully.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":624},"id":"Fx-A1fvkQwU1","executionInfo":{"status":"ok","timestamp":1795610153706,"user_tz":480,"elapsed":2791,"user":{"displayName":"Otuko Jack","userId":"08583356222525555535"}},"outputId":"ad4b51c5-129e-446f-99a3-7430057b87c4"},"execution_count":14,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Feature importance graph saved successfully.\n"]}]},{"cell_type":"markdown","source":["### Feature Importance and HR Actions\n","\n","The five most important features identified by the Random Forest are MonthlyIncome, TotalWorkingYears, Age, DailyRate and DistanceFromHome.\n","\n","HR can take action on some of these factors:\n","\n","1. **MonthlyIncome:** Review salary fairness, compensation and opportunities for salary growth.\n","2. **TotalWorkingYears:** Provide career development, mentoring and progression opportunities.\n","3. **DailyRate:** Review compensation arrangements and whether pay structures are fair and appropriate.\n","4. **DistanceFromHome:** Consider flexible working arrangements or transport support where practical.\n","\n","Age is not an appropriate factor for discriminatory employment decisions. HR should use model findings to investigate workplace conditions and provide support, not to penalise employees based on personal characteristics.\n","\n","Feature importance shows how useful a feature was to the model; it does not establish that changing the feature will reduce attrition."],"metadata":{"id":"cWcRJjTMQ7i9"}},{"cell_type":"markdown","source":["### Written Answer: Why Random Forest Usually Beats One Decision Tree\n","\n","A single decision tree can easily overfit because it may learn specific patterns and noise in the training data.\n","\n","A Random Forest combines predictions from many decision trees trained on different samples and feature subsets. This reduces dependence on one tree and usually improves stability and generalisation to unseen data.\n","\n","In our results, the Random Forest achieved 84.69% test accuracy, compared with 82.99% for the single decision tree. However, its F1-score was lower at 0.1818, compared with 0.3243 for the single tree. This shows that Random Forest did not perform better on every evaluation metric in this experiment.\n","\n","Gradient Boosting achieved the best test accuracy (86.05%) and F1-score (0.3279) among the three models."],"metadata":{"id":"JXeowYD5RzJy"}},{"cell_type":"code","source":["required_variables = [\n","    \"tree3\",\n","    \"ig_root\",\n","    \"depth_results\",\n","    \"results_trees\",\n","    \"importances\"\n","]\n","\n","for variable in required_variables:\n","    print(\n","        variable,\n","        \":\",\n","        \"Available\" if variable in globals() else \"Missing\"\n","    )"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"XLI3pFBMQ-1d","executionInfo":{"status":"ok","timestamp":1795610153751,"user_tz":480,"elapsed":47,"user":{"displayName":"Otuko Jack","userId":"08583356222525555535"}},"outputId":"5b0a7c6d-ba7e-469f-809a-e5fa5b442536"},"execution_count":15,"outputs":[{"output_type":"stream","name":"stdout","text":["tree3 : Available\n","ig_root : Available\n","depth_results : Available\n","results_trees : Available\n","importances : Available\n"]}]},{"cell_type":"code","source":["required_files = [\n","    \"tree_depth3.png\",\n","    \"depth_curve.png\",\n","    \"feature_importance.png\"\n","]\n","\n","for filename in required_files:\n","    file_path = os.path.join(output_folder, filename)\n","\n","    if os.path.isfile(file_path):\n","        size_kb = os.path.getsize(file_path) / 1024\n","        print(f\"{filename}: Found ({size_kb:.2f} KB)\")\n","    else:\n","        print(f\"{filename}: Missing\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"3UZ2sVIeSIKK","executionInfo":{"status":"ok","timestamp":1795610153827,"user_tz":480,"elapsed":72,"user":{"displayName":"Otuko Jack","userId":"08583356222525555535"}},"outputId":"c284df33-dedd-4f97-e563-1ed1fdee1349"},"execution_count":16,"outputs":[{"output_type":"stream","name":"stdout","text":["tree_depth3.png: Found (572.70 KB)\n","depth_curve.png: Found (160.93 KB)\n","feature_importance.png: Found (150.99 KB)\n"]}]}]}