n","          await google.colab.kernel.invokeFunction('convertToInteractive',\n","                                                    [key], {});\n","        if (!dataTable) return;\n","\n","        const docLinkHtml = 'Like what you see? Visit the ' +\n","          '<a target=\"_blank\" href=https://colab.research.google.com/notebooks/data_table.ipynb>data table notebook</a>'\n","          + ' to learn more about interactive tables.';\n","        element.innerHTML = '';\n","        dataTable['output_type'] = 'display_data';\n","        await google.colab.output.renderOutput(dataTable, element);\n","        const docLink = document.createElement('div');\n","        docLink.innerHTML = docLinkHtml;\n","        element.appendChild(docLink);\n","      }\n","    </script>\n","  </div>\n","\n","\n","    </div>\n","  </div>\n"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"dataframe","variable_name":"df_clean"}},"metadata":{},"execution_count":3}]},{"cell_type":"code","source":["# Separate features (X) and target (y)\n","target_column = \"MonthlyIncome\"\n","\n","excluded_columns = [\n","    \"MonthlyIncome\",\n","    \"Attrition\",\n","    \"JobLevel\",\n","    \"age_band\"\n","]\n","\n","X = df_clean.drop(columns=excluded_columns)\n","y = df_clean[target_column]\n","\n","print(\"Features shape:\", X.shape)\n","print(\"Target shape:\", y.shape)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"aYQXmvf3cRhh","executionInfo":{"status":"ok","timestamp":1795525404692,"user_tz":-180,"elapsed":14,"user":{"displayName":"Abel Nyamora","userId":"02911745955096238425"}},"outputId":"17ea8604-56bb-4dad-c536-82f27de86d8f"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["Features shape: (1470, 47)\n","Target shape: (1470,)\n"]}]},{"cell_type":"code","source":["from sklearn.model_selection import train_test_split\n","\n","# Split data into 80% training and 20% testing\n","X_train, X_test, y_train, y_test = train_test_split(\n","    X,\n","    y,\n","    test_size=0.20,\n","    random_state=42,\n","    stratify=df_clean[\"Attrition\"]\n",")\n","\n","print(\"Training features:\", X_train.shape)\n","print(\"Testing features:\", X_test.shape)\n","print(\"Training target:\", y_train.shape)\n","print(\"Testing target:\", y_test.shape)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"CFXaHglZcleM","executionInfo":{"status":"ok","timestamp":1795525404710,"user_tz":-180,"elapsed":15,"user":{"displayName":"Abel Nyamora","userId":"02911745955096238425"}},"outputId":"b2b6c9e3-36f7-4892-e35a-13f165a1cb53"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["Training features: (1176, 47)\n","Testing features: (294, 47)\n","Training target: (1176,)\n","Testing target: (294,)\n"]}]},{"cell_type":"code","source":["# Scale features using training data only\n","scaler = StandardScaler()\n","\n","X_train_scaled = scaler.fit_transform(X_train)\n","X_test_scaled = scaler.transform(X_test)\n","\n","print(\"Scaled training data:\", X_train_scaled.shape)\n","print(\"Scaled testing data:\", X_test_scaled.shape)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"c5AbCn-QdHGc","executionInfo":{"status":"ok","timestamp":1795525404762,"user_tz":-180,"elapsed":19,"user":{"displayName":"Abel Nyamora","userId":"02911745955096238425"}},"outputId":"5bd39baf-4a9d-4125-e083-ee6c25792aad"},"execution_count":6,"outputs":[{"output_type":"stream","name":"stdout","text":["Scaled training data: (1176, 47)\n","Scaled testing data: (294, 47)\n"]}]},{"cell_type":"code","source":["# Select TotalWorkingYears as the only feature\n","X_simple_train = X_train[[\"TotalWorkingYears\"]]\n","X_simple_test = X_test[[\"TotalWorkingYears\"]]\n","\n","# Create and train the simple linear regression model\n","lr_simple = LinearRegression()\n","lr_simple.fit(X_simple_train, y_train)\n","\n","# Display intercept and slope\n","b0 = lr_simple.intercept_\n","b1 = lr_simple.coef_[0]\n","\n","print(\"Intercept (b0):\", b0)\n","print(\"Slope (b1):\", b1)\n","\n","print(f\"\\nFitted equation: MonthlyIncome = {b0:.2f} + ({b1:.2f} × TotalWorkingYears)\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"IUMUcC-CdpW0","executionInfo":{"status":"ok","timestamp":1795525404987,"user_tz":-180,"elapsed":195,"user":{"displayName":"Abel Nyamora","userId":"02911745955096238425"}},"outputId":"7c24b5af-9dde-4b1e-a682-3383e2712a64"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["Intercept (b0): 1291.1329120497821\n","Slope (b1): 462.20730979644264\n","\n","Fitted equation: MonthlyIncome = 1291.13 + (462.21 × TotalWorkingYears)\n"]}]},{"cell_type":"code","source":["# Predict income for the training data\n","y_simple_train_pred = lr_simple.predict(X_simple_train)\n","\n","# Plot actual training points\n","plt.figure(figsize=(9, 5))\n","plt.scatter(\n","    X_simple_train[\"TotalWorkingYears\"],\n","    y_train,\n","    alpha=0.5,\n","    label=\"Actual training data\"\n",")\n","\n","# Plot fitted regression line\n","plt.plot(\n","    X_simple_train[\"TotalWorkingYears\"],\n","    y_simple_train_pred,\n","    color=\"red\",\n","    label=\"Regression line\"\n",")\n","\n","plt.xlabel(\"Total Working Years\")\n","plt.ylabel(\"Monthly Income\")\n","plt.title(\"Simple Linear Regression: Experience vs Monthly Income\")\n","plt.legend()\n","plt.grid(True)\n","\n","# Save the figure\n","plt.savefig(OUTPUT_DIR / \"simple_fit.png\", dpi=300, bbox_inches=\"tight\")\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":487},"id":"JxneCvJweFS-","executionInfo":{"status":"ok","timestamp":1795525407613,"user_tz":-180,"elapsed":2631,"user":{"displayName":"Abel Nyamora","userId":"02911745955096238425"}},"outputId":"08368a32-1efa-4136-ef27-337b4fceaf36"},"execution_count":8,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 900x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Get the first test employee's experience and actual income\n","first_x = X_simple_test.iloc[0, 0]\n","first_actual = y_test.iloc[0]\n","\n","# Calculate prediction manually using the regression equation\n","first_prediction_manual = b0 + b1 * first_x\n","\n","# Confirm prediction using scikit-learn\n","first_prediction_code = lr_simple.predict(X_simple_test.iloc[[0]])[0]\n","\n","# Calculate residual\n","residual = first_actual - first_prediction_code\n","\n","print(\"Years of experience:\", first_x)\n","print(\"Actual monthly income:\", first_actual)\n","print(\"Manual prediction:\", first_prediction_manual)\n","print(\"Code prediction:\", first_prediction_code)\n","print(\"Residual:\", residual)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"PHGJLLcferii","executionInfo":{"status":"ok","timestamp":1795525407655,"user_tz":-180,"elapsed":16,"user":{"displayName":"Abel Nyamora","userId":"02911745955096238425"}},"outputId":"4b0847ae-4cb1-4a2d-88a5-6c0ed062c626"},"execution_count":9,"outputs":[{"output_type":"stream","name":"stdout","text":["Years of experience: 1\n","Actual monthly income: 2033\n","Manual prediction: 1753.3402218462247\n","Code prediction: 1753.3402218462247\n","Residual: 279.6597781537753\n"]}]},{"cell_type":"markdown","source":["### Interpretation of Simple Linear Regression\n","\n","The intercept (b0) of 1291.13 means that the model predicts a monthly income of approximately 1291.13 for an employee with zero years of working experience.\n","\n","The slope (b1) of 462.21 indicates that each additional year of working experience is associated with an estimated increase of 462.21 in monthly income.\n","\n","For the first test employee, who has one year of experience, the predicted monthly income is 1753.34, while the actual income is 2033. The residual is +279.66, meaning the model underestimated the employee's actual monthly income by approximately 279.66."],"metadata":{"id":"xkifD6ARfADp"}},{"cell_type":"code","source":["# Create the multiple linear regression model\n","lr_multi = LinearRegression()\n","\n","# Train the model using scaled training data\n","lr_multi.fit(X_train_scaled, y_train)\n","\n","# Predict monthly income for training and testing data\n","y_multi_train_pred = lr_multi.predict(X_train_scaled)\n","y_multi_test_pred = lr_multi.predict(X_test_scaled)\n","\n","print(\"Multiple Linear Regression trained successfully!\")\n","print(\"Training predictions:\", len(y_multi_train_pred))\n","print(\"Testing predictions:\", len(y_multi_test_pred))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"cZfHCe1ofvB8","executionInfo":{"status":"ok","timestamp":1795525407703,"user_tz":-180,"elapsed":45,"user":{"displayName":"Abel Nyamora","userId":"02911745955096238425"}},"outputId":"37b6aa23-cb34-463b-b104-f82256230b2d"},"execution_count":10,"outputs":[{"output_type":"stream","name":"stdout","text":["Multiple Linear Regression trained successfully!\n","Training predictions: 1176\n","Testing predictions: 294\n"]}]},{"cell_type":"code","source":["# Calculate training metrics\n","train_mae = mean_absolute_error(y_train, y_multi_train_pred)\n","train_mse = mean_squared_error(y_train, y_multi_train_pred)\n","train_rmse = np.sqrt(train_mse)\n","train_r2 = r2_score(y_train, y_multi_train_pred)\n","\n","# Calculate testing metrics\n","test_mae = mean_absolute_error(y_test, y_multi_test_pred)\n","test_mse = mean_squared_error(y_test, y_multi_test_pred)\n","test_rmse = np.sqrt(test_mse)\n","test_r2 = r2_score(y_test, y_multi_test_pred)\n","\n","# Store all metrics in a dictionary\n","metrics_multi = {\n","    \"Train_MAE\": train_mae,\n","    \"Train_MSE\": train_mse,\n","    \"Train_RMSE\": train_rmse,\n","    \"Train_R2\": train_r2,\n","    \"Test_MAE\": test_mae,\n","    \"Test_MSE\": test_mse,\n","    \"Test_RMSE\": test_rmse,\n","    \"Test_R2\": test_r2\n","}\n","\n","# Display results\n","for metric, value in metrics_multi.items():\n","    print(f\"{metric}: {value:.4f}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"vBRH0DpogJ6r","executionInfo":{"status":"ok","timestamp":1795525407768,"user_tz":-180,"elapsed":62,"user":{"displayName":"Abel Nyamora","userId":"02911745955096238425"}},"outputId":"20216c15-7074-45cd-8426-6efb1ab1270a"},"execution_count":11,"outputs":[{"output_type":"stream","name":"stdout","text":["Train_MAE: 1270.6837\n","Train_MSE: 2618788.1524\n","Train_RMSE: 1618.2670\n","Train_R2: 0.8790\n","Test_MAE: 1325.3870\n","Test_MSE: 2868819.7220\n","Test_RMSE: 1693.7591\n","Test_R2: 0.8813\n"]}]},{"cell_type":"code","source":["plt.figure(figsize=(8, 6))\n","\n","plt.scatter(\n","    y_test,\n","    y_multi_test_pred,\n","    alpha=0.6\n",")\n","\n","# Reference line for perfect predictions\n","min_value = min(y_test.min(), y_multi_test_pred.min())\n","max_value = max(y_test.max(), y_multi_test_pred.max())\n","\n","plt.plot(\n","    [min_value, max_value],\n","    [min_value, max_value],\n","    color=\"red\",\n","    linestyle=\"--\",\n","    label=\"Perfect prediction\"\n",")\n","\n","plt.xlabel(\"Actual Monthly Income\")\n","plt.ylabel(\"Predicted Monthly Income\")\n","plt.title(\"Actual vs Predicted Monthly Income\")\n","plt.legend()\n","plt.grid(True)\n","\n","# Save the figure\n","plt.savefig(\n","    OUTPUT_DIR / \"actual_vs_pred.png\",\n","    dpi=300,\n","    bbox_inches=\"tight\"\n",")\n","\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":564},"id":"qATarCozgoNE","executionInfo":{"status":"ok","timestamp":1795525408467,"user_tz":-180,"elapsed":694,"user":{"displayName":"Abel Nyamora","userId":"02911745955096238425"}},"outputId":"3528f29d-3ff3-409f-afa9-090707835c6d"},"execution_count":12,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Scale the single feature\n","simple_scaler = StandardScaler()\n","\n","X_gd_train = simple_scaler.fit_transform(\n","    X_simple_train\n",").flatten()\n","\n","y_gd_train = y_train.to_numpy()\n","\n","print(\"Scaled feature shape:\", X_gd_train.shape)\n","print(\"Target shape:\", y_gd_train.shape)\n","print(\"Feature mean:\", X_gd_train.mean())\n","print(\"Feature standard deviation:\", X_gd_train.std())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"JoHkfOZBha0j","executionInfo":{"status":"ok","timestamp":1795525408484,"user_tz":-180,"elapsed":15,"user":{"displayName":"Abel Nyamora","userId":"02911745955096238425"}},"outputId":"b7412975-3b68-4225-e2b9-e1dd2c9039aa"},"execution_count":13,"outputs":[{"output_type":"stream","name":"stdout","text":["Scaled feature shape: (1176,)\n","Target shape: (1176,)\n","Feature mean: -7.288198767097116e-17\n","Feature standard deviation: 0.9999999999999999\n"]}]},{"cell_type":"code","source":["def gradient_descent(X, y, learning_rate, iterations):\n","    m = len(y)\n","\n","    # Initialize parameters\n","    b0 = 0.0\n","    b1 = 0.0\n","\n","    cost_history = []\n","\n","    for i in range(iterations):\n","\n","        # Make predictions\n","        y_pred = b0 + b1 * X\n","\n","        # Calculate errors\n","        error = y_pred - y\n","\n","        # Calculate gradients\n","        db0 = (1 / m) * np.sum(error)\n","        db1 = (1 / m) * np.sum(error * X)\n","\n","        # Update parameters\n","        b0 = b0 - learning_rate * db0\n","        b1 = b1 - learning_rate * db1\n","\n","        # Calculate and store cost\n","        cost = (1 / (2 * m)) * np.sum(error ** 2)\n","        cost_history.append(cost)\n","\n","    return b0, b1, cost_history\n","\n","\n","print(\"Gradient descent function created successfully!\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"LzjDKZeXhz3S","executionInfo":{"status":"ok","timestamp":1795525408546,"user_tz":-180,"elapsed":60,"user":{"displayName":"Abel Nyamora","userId":"02911745955096238425"}},"outputId":"b94f8c31-fa66-4538-ad22-47807c4b5bf7"},"execution_count":14,"outputs":[{"output_type":"stream","name":"stdout","text":["Gradient descent function created successfully!\n"]}]},{"cell_type":"code","source":["learning_rates = [0.001, 0.01, 0.1]\n","iterations = 1000\n","\n","cost_history = {}\n","gd_results = {}\n","\n","for alpha in learning_rates:\n","\n","    b0_temp, b1_temp, costs = gradient_descent(\n","        X_gd_train,\n","        y_gd_train,\n","        alpha,\n","        iterations\n","    )\n","\n","    cost_history[alpha] = costs\n","    gd_results[alpha] = (b0_temp, b1_temp)\n","\n","    print(\"Learning rate:\", alpha)\n","    print(\"Final intercept:\", b0_temp)\n","    print(\"Final slope:\", b1_temp)\n","    print(\"Final cost:\", costs[-1])\n","    print(\"-\" * 40)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"YhxbDVdEiC9L","executionInfo":{"status":"ok","timestamp":1795525408612,"user_tz":-180,"elapsed":64,"user":{"displayName":"Abel Nyamora","userId":"02911745955096238425"}},"outputId":"622daf33-3d5f-4c18-8d2e-867f23a83d6c"},"execution_count":15,"outputs":[{"output_type":"stream","name":"stdout","text":["Learning rate: 0.001\n","Final intercept: 4137.816732843605\n","Final slope: 2279.0321990711996\n","Final cost: 8104551.727405581\n","----------------------------------------\n","Learning rate: 0.01\n","Final intercept: 6543.7421461562935\n","Final slope: 3604.17099557249\n","Final cost: 4323873.287099163\n","----------------------------------------\n","Learning rate: 0.1\n","Final intercept: 6544.024659863942\n","Final slope: 3604.326598847837\n","Final cost: 4323873.2340298975\n","----------------------------------------\n"]}]},{"cell_type":"code","source":["plt.figure(figsize=(9, 5))\n","\n","for alpha, costs in cost_history.items():\n","    plt.plot(costs, label=f\"Learning rate = {alpha}\")\n","\n","plt.xlabel(\"Iterations\")\n","plt.ylabel(\"Cost\")\n","plt.title(\"Gradient Descent: Cost vs Iterations\")\n","plt.legend()\n","plt.grid(True)\n","\n","# Save the graph\n","plt.savefig(\n","    OUTPUT_DIR / \"gd_cost.png\",\n","    dpi=300,\n","    bbox_inches=\"tight\"\n",")\n","\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":487},"id":"gyvNjPIciOMa","executionInfo":{"status":"ok","timestamp":1795525409528,"user_tz":-180,"elapsed":909,"user":{"displayName":"Abel Nyamora","userId":"02911745955096238425"}},"outputId":"72d22841-d7cd-4001-facd-ff5c9b475540"},"execution_count":16,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 900x500 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["# Get gradient descent coefficients using learning rate 0.1\n","b0_gd, b1_gd = gd_results[0.1]\n","\n","# Train Scikit-learn on the same scaled feature\n","lr_scaled = LinearRegression()\n","lr_scaled.fit(X_gd_train.reshape(-1, 1), y_gd_train)\n","\n","# Get Scikit-learn coefficients\n","b0_sklearn = lr_scaled.intercept_\n","b1_sklearn = lr_scaled.coef_[0]\n","\n","# Display comparison\n","print(\"GRADIENT DESCENT\")\n","print(\"Intercept:\", b0_gd)\n","print(\"Slope:\", b1_gd)\n","\n","print(\"\\nSCIKIT-LEARN\")\n","print(\"Intercept:\", b0_sklearn)\n","print(\"Slope:\", b1_sklearn)\n","\n","print(\"\\nDIFFERENCES\")\n","print(\"Intercept difference:\", abs(b0_gd - b0_sklearn))\n","print(\"Slope difference:\", abs(b1_gd - b1_sklearn))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"GAF78qhVirJ1","executionInfo":{"status":"ok","timestamp":1795525409666,"user_tz":-180,"elapsed":136,"user":{"displayName":"Abel Nyamora","userId":"02911745955096238425"}},"outputId":"edc1200c-3c1a-402f-8949-adc801c83efe"},"execution_count":17,"outputs":[{"output_type":"stream","name":"stdout","text":["GRADIENT DESCENT\n","Intercept: 6544.024659863942\n","Slope: 3604.326598847837\n","\n","SCIKIT-LEARN\n","Intercept: 6544.024659863946\n","Slope: 3604.3265988478406\n","\n","DIFFERENCES\n","Intercept difference: 3.637978807091713e-12\n","Slope difference: 3.637978807091713e-12\n"]}]},{"cell_type":"markdown","source":["### Gradient Descent Interpretation\n","\n","The learning rate of 0.001 produced a final cost of 8104551.73, showing slower convergence after 1000 iterations. The learning rate of 0.01 reduced the final cost to 4323873.29, while 0.1 achieved a slightly lower cost of 4323873.23. Therefore, 0.1 provided the fastest convergence among the three learning rates tested. The Gradient Descent coefficients were almost identical to those from Scikit-learn because both methods converged to the same optimal linear regression solution using the same scaled feature."],"metadata":{"id":"Bov2SpDUi87-"}},{"cell_type":"code","source":["# Check required variables\n","required_variables = [\n","    \"lr_simple\",\n","    \"lr_multi\",\n","    \"metrics_multi\",\n","    \"b0_gd\",\n","    \"b1_gd\",\n","    \"cost_history\"\n","]\n","\n","print(\"VARIABLE CHECK\")\n","\n","for variable in required_variables:\n","    print(variable, \":\", \"Available\" if variable in globals() else \"Missing\")\n","\n","# Check saved graphs\n","required_graphs = [\n","    \"simple_fit.png\",\n","    \"actual_vs_pred.png\",\n","    \"gd_cost.png\"\n","]\n","\n","print(\"\\nGRAPH CHECK\")\n","\n","for graph in required_graphs:\n","    path = OUTPUT_DIR / graph\n","    print(graph, \":\", \"Saved\" if path.exists() else \"Missing\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"fw1F_hvijJrE","executionInfo":{"status":"ok","timestamp":1795525409703,"user_tz":-180,"elapsed":33,"user":{"displayName":"Abel Nyamora","userId":"02911745955096238425"}},"outputId":"c173aa57-f059-4ce8-c969-a498858f70b9"},"execution_count":18,"outputs":[{"output_type":"stream","name":"stdout","text":["VARIABLE CHECK\n","lr_simple : Available\n","lr_multi : Available\n","metrics_multi : Available\n","b0_gd : Available\n","b1_gd : Available\n","cost_history : Available\n","\n","GRAPH CHECK\n","simple_fit.png : Saved\n","actual_vs_pred.png : Saved\n","gd_cost.png : Saved\n"]}]},{"cell_type":"markdown","source":[],"metadata":{"id":"2p-xduCbakk9"}}]}